{
  "buildCommand": "cd packages/frontend && npm run build",
  "outputDirectory": "packages/frontend/dist",

  "functions": {
    "packages/backend/api/index.ts": {
      "runtime": "nodejs@22.x"
    }
  },

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}