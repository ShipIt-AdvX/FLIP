{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "cd packages/frontend && npm run build",
    "outputDirectory": "packages/frontend/dist",

    "functions": {
        "packages/backend/src/core.[jt]s": {
            "maxDuration": "max"
        }
    },

    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api"
        }
    ]
}